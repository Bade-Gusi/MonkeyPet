<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>baba</RootNamespace>
    <AssemblyName>baba</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>2.0.0</Version>
    <Product>弹性桌面物品</Product>
    <AssemblyTitle>弹性桌面物品</AssemblyTitle>
    <Description>弹性桌面物品 - 全屏桌面小物：爬行、弹跳、喊爸爸、抢香蕉、自动更新</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- assets 文件夹里的素材（p1~p4.png、dad.wav）在编译时自动复制到输出目录 -->
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
